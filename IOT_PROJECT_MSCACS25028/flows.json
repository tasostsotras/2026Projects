    {
        "id": "thermostat",
        "type": "function",
        "z": "e68360b499a4fae1",
        "name": "Thermostat Logic",
        "func": "let desired = flow.get(\"desiredTemp\") || 22;\nlet on = flow.get(\"thermostatOn\") || false;\nlet current = msg.payload.temperature;\n\nif (!on) {\n    msg.payload = \"HEATING_OFF\";\n} else if (current < desired) {\n    msg.payload = \"HEATING_ON\";\n} else {\n    msg.payload = \"HEATING_OFF\";\n}\n\nreturn msg;",
        "outputs": 1,
        "x": 720,
        "y": 380,
        "wires": [
            [
                "mqtt_out",
                "9692e3140c8c683b"
            ]
        ]
